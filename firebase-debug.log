[debug] [2026-03-30T02:13:39.686Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/proyecto-tiendas-5a23f/rulesets {"name":"projects/proyecto-tiendas-5a23f/rulesets/b771d640-313d-4db7-a46b-9af2e5e1908f","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    \r\n    // Helper: User is authenticated\r\n    function isAuthenticated() {\r\n      // return request.auth != null; \r\n      return true; // TEMPORARY DEV MODE: Allow all writes because we use Mock Auth (localStorage)\r\n    }\r\n\r\n    // Helper: User owns the shop (Phase 2: Check 'ownerId' field)\r\n    // For Phase 1 (Prototype with shared credentials), we basically check if they are logged in.\r\n    function isShopOwner(shopId) {\r\n      return isAuthenticated(); \r\n    }\r\n\r\n    // SHOPS: Public profiles, but restricted editing\r\n    match /shops/{shopId} {\r\n      allow read: if true;\r\n      allow create: if isAuthenticated() || \r\n                       request.resource.id.matches('^demo-.*') || \r\n                       request.resource.id == 'legacy-1' ||\r\n                       request.resource.id == 'legacy-gonzalez';\r\n      allow update: if isShopOwner(shopId);\r\n      allow delete: if isShopOwner(shopId);\r\n      \r\n      // SHOP SUBCOLLECTIONS (if any, like 'products' if subcollection)\r\n      // SHOP SUBCOLLECTIONS\r\n      match /products/{productId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n\r\n      match /services/{serviceId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n\r\n      // BOOKING SERVICES (new booking system collection)\r\n      match /bookingServices/{serviceId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n\r\n      // SHOP SETTINGS (custom categories, etc.)\r\n      match /settings/{settingId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n\r\n      // STAFF & CONFIG\r\n      match /staff/{staffId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n      match /orderAssignmentConfig/{docId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n\r\n    // WHATSAPP BOT CONFIG\r\n      match /whatsapp_bot/{document=**} {\r\n        allow read, write: if isShopOwner(shopId);\r\n      }\r\n\r\n      // BOOKING CONFIG (Fix for Profile Saving)\r\n      match /bookingConfig/{document=**} {\r\n        allow read, write: if isShopOwner(shopId);\r\n      }\r\n\r\n      // OPERATIONAL DATA (Rentals, Assignments, etc.)\r\n      match /rentals/{rentalId} {\r\n        allow read: if true;\r\n        allow write: if true; // Open for demo purposes (bookings)\r\n      }\r\n      match /vehicles/{vehicleId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n      match /orderAssignments/{assignmentId} {\r\n        allow read: if true;\r\n        allow write: if true; // Internal logic often runs as client for now\r\n      }\r\n      match /assignmentNotifications/{notifId} {\r\n         allow read: if true;\r\n         allow write: if true; \r\n      }\r\n      match /appointments/{apptId} {\r\n         allow read: if true;\r\n         allow write: if true; // Public booking\r\n      }\r\n\r\n      // ORDERS - Public can create (from cart), owners can manage\r\n      match /orders/{orderId} {\r\n        allow read: if true;\r\n        allow create: if true; // Anyone can place an order\r\n        allow update, delete: if isShopOwner(shopId);\r\n      }\r\n\r\n      // NOTIFICATIONS - For admin dashboard alerts\r\n      match /notifications/{notifId} {\r\n        allow read: if true;\r\n        allow create: if true; // System/public can create\r\n        allow update, delete: if isShopOwner(shopId);\r\n      }\r\n\r\n      // PUSH SUBSCRIPTIONS - For PWA push notifications\r\n      match /pushSubscriptions/{subId} {\r\n        allow read: if true;\r\n        allow write: if true; // Browsers need to subscribe\r\n      }\r\n\r\n      // CUSTOMERS - CRM data\r\n      match /customers/{customerId} {\r\n        allow read: if true;\r\n        allow write: if true; // WhatsApp webhook creates customers\r\n      }\r\n\r\n      // BOOKINGS - Service appointments\r\n      match /bookings/{bookingId} {\r\n        allow read: if true;\r\n        allow write: if true; // Public booking flow\r\n      }\r\n\r\n      // CHAT SESSIONS - Live chat widget\r\n      match /chatSessions/{sessionId} {\r\n        allow read: if true;\r\n        allow create: if true; // Customers can open a session\r\n        allow update: if true; // Agent and customer can update status\r\n        allow delete: if isShopOwner(shopId);\r\n\r\n        match /messages/{messageId} {\r\n          allow read: if true;\r\n          allow create: if true; // Both sides can send messages\r\n          allow update, delete: if isShopOwner(shopId);\r\n        }\r\n      }\r\n\r\n      // TRAINING PACKAGES - CRM/Admin\r\n      match /training-packages/{packageId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n    }\r\n    \r\n    // PRODUCTS: If stored as root collection (optional architecture)\r\n    // We are likely storing them inside shops/{shopId}/products or root 'products' with shopId field.\r\n    // Let's support both for flexibility.\r\n    match /products/{productId} {\r\n      allow read: if true;\r\n    }\r\n    \r\n    // AGENCY CONFIG: Public read, admin write\r\n    match /agency/{document=**} {\r\n      allow read: if true;\r\n      allow write: if isAuthenticated();\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-03-30T02:13:39.941871Z","metadata":{"services":["cloud.firestore"]}}
