[debug] [2026-02-07T23:54:01.673Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/proyecto-tiendas-5a23f/rulesets {"name":"projects/proyecto-tiendas-5a23f/rulesets/bed3a624-f765-4b8b-a0c3-ec718fbe3932","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    \r\n    // Helper: User is authenticated\r\n    function isAuthenticated() {\r\n      // return request.auth != null; \r\n      return true; // TEMPORARY DEV MODE: Allow all writes because we use Mock Auth (localStorage)\r\n    }\r\n\r\n    // Helper: User owns the shop (Phase 2: Check 'ownerId' field)\r\n    // For Phase 1 (Prototype with shared credentials), we basically check if they are logged in.\r\n    function isShopOwner(shopId) {\r\n      return isAuthenticated(); \r\n    }\r\n\r\n    // SHOPS: Public profiles, but restricted editing\r\n    match /shops/{shopId} {\r\n      allow read: if true;\r\n      allow create: if isAuthenticated() || \r\n                       request.resource.id.matches('^demo-.*') || \r\n                       request.resource.id == 'legacy-1' ||\r\n                       request.resource.id == 'legacy-gonzalez';\r\n      allow update: if isShopOwner(shopId);\r\n      allow delete: if isShopOwner(shopId);\r\n      \r\n      // SHOP SUBCOLLECTIONS (if any, like 'products' if subcollection)\r\n      // SHOP SUBCOLLECTIONS\r\n      match /products/{productId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n\r\n      match /services/{serviceId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n      \r\n      // STAFF & CONFIG\r\n      match /staff/{staffId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n      match /orderAssignmentConfig/{docId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n\r\n    // WHATSAPP BOT CONFIG\r\n      match /whatsapp_bot/{document=**} {\r\n        allow read, write: if isShopOwner(shopId);\r\n      }\r\n\r\n      // OPERATIONAL DATA (Rentals, Assignments, etc.)\r\n      match /rentals/{rentalId} {\r\n        allow read: if true;\r\n        allow write: if true; // Open for demo purposes (bookings)\r\n      }\r\n      match /vehicles/{vehicleId} {\r\n        allow read: if true;\r\n        allow write: if isShopOwner(shopId);\r\n      }\r\n      match /orderAssignments/{assignmentId} {\r\n        allow read: if true;\r\n        allow write: if true; // Internal logic often runs as client for now\r\n      }\r\n      match /assignmentNotifications/{notifId} {\r\n         allow read: if true;\r\n         allow write: if true; \r\n      }\r\n      match /appointments/{apptId} {\r\n         allow read: if true;\r\n         allow write: if true; // Public booking\r\n      }\r\n    }\r\n    \r\n    // PRODUCTS: If stored as root collection (optional architecture)\r\n    // We are likely storing them inside shops/{shopId}/products or root 'products' with shopId field.\r\n    // Let's support both for flexibility.\r\n    match /products/{productId} {\r\n      allow read: if true;\r\n      allow write: if isAuthenticated() && (resource.data.shopId == request.auth.uid || request.resource.data.shopId == request.auth.uid); \r\n      // Note: This assumes Mapping shopId <-> auth.uid which we might not have yet.\r\n      // Fallback:\r\n      allow write: if isAuthenticated();\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-02-07T23:54:01.739567Z","metadata":{"services":["cloud.firestore"]}}
