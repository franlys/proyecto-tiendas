rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to everyone (public images)
      allow read: if true;
      
      // Allow write access only to authenticated users
      // Limit size to 50MB (for videos) and ensure it is an image or video
      // PUBLIC ACCESS (DEV MODE):
      // Since the app uses Mock Auth (localStorage) and not Firebase Auth,
      // request.auth is null. We must allow writes to enable uploads.
      allow write: if true;
    }
  }
}
