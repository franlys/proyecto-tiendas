rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: User is authenticated
    function isAuthenticated() {
      // return request.auth != null; 
      return true; // TEMPORARY DEV MODE: Allow all writes because we use Mock Auth (localStorage)
    }

    // Helper: User owns the shop (Phase 2: Check 'ownerId' field)
    // For Phase 1 (Prototype with shared credentials), we basically check if they are logged in.
    function isShopOwner(shopId) {
      return isAuthenticated(); 
    }

    // SHOPS: Public profiles, but restricted editing
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAuthenticated() || 
                       request.resource.id.matches('^demo-.*') || 
                       request.resource.id == 'legacy-1' ||
                       request.resource.id == 'legacy-gonzalez';
      allow update: if isShopOwner(shopId);
      allow delete: if isShopOwner(shopId);
      
      // SHOP SUBCOLLECTIONS (if any, like 'products' if subcollection)
      // SHOP SUBCOLLECTIONS
      match /products/{productId} {
        allow read: if true;
        allow write: if isShopOwner(shopId);
      }

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isShopOwner(shopId);
      }

      // SHOP SETTINGS (custom categories, etc.)
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isShopOwner(shopId);
      }

      // STAFF & CONFIG
      match /staff/{staffId} {
        allow read: if true;
        allow write: if isShopOwner(shopId);
      }
      match /orderAssignmentConfig/{docId} {
        allow read: if true;
        allow write: if isShopOwner(shopId);
      }

    // WHATSAPP BOT CONFIG
      match /whatsapp_bot/{document=**} {
        allow read, write: if isShopOwner(shopId);
      }

      // OPERATIONAL DATA (Rentals, Assignments, etc.)
      match /rentals/{rentalId} {
        allow read: if true;
        allow write: if true; // Open for demo purposes (bookings)
      }
      match /vehicles/{vehicleId} {
        allow read: if true;
        allow write: if isShopOwner(shopId);
      }
      match /orderAssignments/{assignmentId} {
        allow read: if true;
        allow write: if true; // Internal logic often runs as client for now
      }
      match /assignmentNotifications/{notifId} {
         allow read: if true;
         allow write: if true; 
      }
      match /appointments/{apptId} {
         allow read: if true;
         allow write: if true; // Public booking
      }

      // ORDERS - Public can create (from cart), owners can manage
      match /orders/{orderId} {
        allow read: if true;
        allow create: if true; // Anyone can place an order
        allow update, delete: if isShopOwner(shopId);
      }

      // NOTIFICATIONS - For admin dashboard alerts
      match /notifications/{notifId} {
        allow read: if true;
        allow create: if true; // System/public can create
        allow update, delete: if isShopOwner(shopId);
      }

      // PUSH SUBSCRIPTIONS - For PWA push notifications
      match /pushSubscriptions/{subId} {
        allow read: if true;
        allow write: if true; // Browsers need to subscribe
      }

      // CUSTOMERS - CRM data
      match /customers/{customerId} {
        allow read: if true;
        allow write: if true; // WhatsApp webhook creates customers
      }

      // BOOKINGS - Service appointments
      match /bookings/{bookingId} {
        allow read: if true;
        allow write: if true; // Public booking flow
      }
    }
    
    // PRODUCTS: If stored as root collection (optional architecture)
    // We are likely storing them inside shops/{shopId}/products or root 'products' with shopId field.
    // Let's support both for flexibility.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && (resource.data.shopId == request.auth.uid || request.resource.data.shopId == request.auth.uid); 
      // Note: This assumes Mapping shopId <-> auth.uid which we might not have yet.
      // Fallback:
      allow write: if isAuthenticated();
    }
  }
}
