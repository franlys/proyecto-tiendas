{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/order-escalation",
      "schedule": "*/0 * * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "/0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}